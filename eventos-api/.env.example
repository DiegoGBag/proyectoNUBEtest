# ---- LOCAL (tu computadora) ----
DATABASE_URL=mssql+pyodbc://@localhost\SQLEXPRESS/EventsDB?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
JWT_SECRET=change_me_generate_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
AWS_S3_BUCKET=
AWS_REGION=us-east-1
APP_ENV=development

# En AWS (pruebas / produccion) las variables viven en /opt/events/test.env y
# /opt/events/prod.env dentro de la EC2. Plantillas en deploy/ec2/.
# Genera cada JWT_SECRET (uno distinto por entorno) con:
#   python -c "import secrets; print(secrets.token_hex(32))"
